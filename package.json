{
  "name": "launchpad-frontend",
  "version": "1.0.0",
  "description": "Frontend for the Launchpad application with login and project management features.",
  "main": "src/index.jsx",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-native-deps.mjs",
    "dev": "ulimit -c 0 2>/dev/null || true; vite",
    "build": "npm run build:embed && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:embed": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --config vite.embed.config.js && node scripts/finalize-embed-artifacts.mjs && node scripts/inject-embed-shim.mjs && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --config vite.preview-capture.config.js",
    "serve": "vite preview",
    "serve:embedded": "node docker-serve.mjs",
    "serve:prod": "npm run build && node docker-serve.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
